[Unit]
Description=Ostrostroj
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/ostrostroj
ExecStart=/usr/local/bin/ostrostroj /srv/ostrostroj/
ExecStopPost=/bin/sh -c \
        'if [ "$EXIT_STATUS" = "2" ]; then systemctl reboot; elif [ "$EXIT_STATUS" = "3" ]; then systemctl poweroff; fi'
Restart=on-failure

[Install]
WantedBy=multi-user.target